{
  "name": "josesierradev/laravel-quickbooks-client",
  "description": "Laravel Client for QuickBooks.",
  "keywords": [
    "quickbooks",
    "client",
    "laravel"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Jimmy Puckett",
      "email": "jimmy.puckett@spinen.com"
    }
  ],
  "require": {
      "php": ">=7.3",
      "illuminate/database": "~5.5|~6|~7|~8|~9",
      "illuminate/http": "~5.5|~6|~7|~8|~9",
      "illuminate/routing": "~5.5|~6|~7|~8|~9",
      "nesbot/carbon": "^1.26.3|^2.0",
      "quickbooks/v3-php-sdk": "^6.1.0"
  },
  "require-dev": {
    "laravel/pint": "^1.2",
    "mockery/mockery": "^1.5.1",
    "phpunit/phpunit": "^9.5.8",
    "psy/psysh": "^0.11",
    "scrutinizer/ocular": "^1.9"
  },
  "autoload": {
    "psr-4": {
      "JoseSierraDev\\QuickBooks\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JoseSierraDev\\QuickBooks\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "JoseSierraDev\\QuickBooks\\Providers\\ServiceProvider",
        "JoseSierraDev\\QuickBooks\\Providers\\ClientServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
